<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for a single reservation item in a list (Redesigned for Paragon Theme)

    DESIGN PRINCIPLES APPLIED:
    1. HIERARCHY: Key details like Date and Time are prominent.
    2. MINIMALISM: A clean, card-based design with clear separation of info and actions. No harsh lines.
    3. CONSISTENCY: Fully integrated with the Charcoal, Maroon, and Gold theme.
    4. CLEAR AFFORDANCE: Buttons are clearly defined actions. "Cancel" uses an error color to warn the user.
    5. ACCESSIBILITY: Content descriptions are clear for icons and actions.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="2dp"
    app:strokeWidth="0.5dp"
    app:strokeColor="?attr/colorOutline"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 1. RESERVATION STATUS ICON (Gold for 'confirmed') -->
        <!-- Subtle Gold -->

        <!-- 2. RESERVATION DETAILS -->
        <!-- Main Info: Date -->
        <ImageView
            android:id="@+id/icon_status"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/desc_reservation_status"
            android:src="@drawable/ic_check_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/pg_primary_accent" />

        <TextView
            android:id="@+id/text_reservation_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/icon_status"
            app:layout_constraintTop_toTopOf="@id/icon_status"
            app:layout_constraintBottom_toBottomOf="@id/icon_status"
            tools:text="November 25, 2025" />

        <!-- Secondary Info: Time and Party Size -->
        <TextView
            android:id="@+id/text_reservation_time_and_guests"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintEnd_toEndOf="@id/text_reservation_date"
            app:layout_constraintStart_toStartOf="@id/text_reservation_date"
            app:layout_constraintTop_toBottomOf="@id/text_reservation_date"
            tools:text="7:00 PM  •  4 Guests" />

        <!-- 3. ACTION BUTTONS -->
        <!-- Using a barrier to ensure buttons are always below the text content -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="text_reservation_time_and_guests" />

        <!-- Modify Button (Outlined style, uses brand accent color) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_modify_reservation"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/modify_button"
            app:layout_constraintEnd_toStartOf="@id/button_cancel_reservation"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrier_content" />

        <!-- Cancel Button (Text Button with error color for warning) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_reservation"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/cancel_button"
            android:textColor="@color/pg_error"
            app:layout_constraintBottom_toBottomOf="@id/button_modify_reservation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/button_modify_reservation"
            app:layout_constraintTop_toTopOf="@id/button_modify_reservation" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
