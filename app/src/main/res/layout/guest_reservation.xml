<?xml version="1.0" encoding="utf-8"?>
<!--
    Guest Reservation Booking Screen (Redesigned for Paragon Theme)

    DESIGN PRINCIPLES APPLIED:
    1. HIERARCHY: Gold title and clear section headers guide the user through the form.
    2. MINIMALISM: Replaced the toolbar with a clean header. Generous spacing makes the form feel less daunting.
    3. CONSISTENCY: Uses the same Charcoal, Maroon, and Gold theme as all other redesigned screens.
    4. CLEAR AFFORDANCE: The final button is a strong Call-to-Action. Input fields are clearly defined.
    5. ACCESSIBILITY: All input fields have clear hints and icons have content descriptions.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".ReservationBookingActivity">

    <!-- 1. SIMPLIFIED HEADER -->
    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_navigate_back"
        android:padding="8dp"
        android:src="@drawable/arrow_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />



    <TextView
        android:id="@+id/text_screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/book_a_table_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="?attr/colorSecondary"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/button_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/button_back" />

    <!-- 2. SCROLLABLE FORM CONTENT -->
    <ScrollView
        android:id="@+id/scroll_view_form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Reservation Details Section -->
            <TextView
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/reservation_details"
                android:textStyle="bold" />

            <!-- Date Picker -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_date"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/hint_date"
                app:hintTextColor="?attr/colorSecondary"
                app:boxStrokeColor="?attr/colorSecondary"
                app:endIconContentDescription="@string/desc_select_date"
                app:endIconDrawable="@drawable/ic_event"
                app:endIconMode="custom"
                app:endIconTint="?attr/colorSecondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Time Picker -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_time"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/hint_time"
                app:hintTextColor="?attr/colorSecondary"
                app:boxStrokeColor="?attr/colorSecondary"
                app:endIconContentDescription="@string/desc_select_time"
                app:endIconDrawable="@drawable/ic_access_time_24"
                app:endIconMode="custom"
                app:endIconTint="?attr/colorSecondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Number of Guests -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_party_size"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="Number of Guests"
                app:hintTextColor="?attr/colorSecondary"
                app:boxStrokeColor="?attr/colorSecondary"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_party_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contact Information Section -->
            <TextView
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/contact_information"
                android:textStyle="bold" />

            <!-- Full Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/hint_full_name"
                app:hintTextColor="?attr/colorSecondary"
                app:boxStrokeColor="?attr/colorSecondary"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contact Number -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_contact"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_contact_number"
                app:hintTextColor="?attr/colorSecondary"
                app:boxStrokeColor="?attr/colorSecondary"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_contact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:imeOptions="actionDone"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Status Spinner (Staff Only) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_status"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Reservation Status"
                android:visibility="gone"
                app:hintTextColor="?attr/colorSecondary"
                app:boxStrokeColor="?attr/colorSecondary"
                app:startIconDrawable="@drawable/ic_check_circle"
                app:startIconTint="?attr/colorPrimary">

                <AutoCompleteTextView
                    android:id="@+id/spinner_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 3. PRIMARY CALL-TO-ACTION BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_confirm_reservation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:paddingVertical="14dp"
        android:text="@string/confirm_reservation_button"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
